{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "types": ["jest", "node"],
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@email/*": ["packages/email/src/*"],
      "email": ["packages/email/src"],
      "email/*": ["packages/email/src/*"],
      "pipes": ["apps/api/src/pipes"]
    }
  },
  // NOTA: La importación de la base de datos debe hacerse usando el nombre del package ("db"),
  // por ejemplo: import { PrismaService } from 'db';
  // No se requieren alias adicionales en "paths" para este caso.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  // Restart
  "references": [
    { "path": "../../packages/config" },
    { "path": "../../packages/db" },
    { "path": "../../packages/email" },
    { "path": "../../packages/ui" }
  ]
}
